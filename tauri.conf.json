{
	"$schema": "https://schema.tauri.app/config/2.0.0-rc",
	"productName": "rism",
	"identifier": "de.chirality.rism",
	"build": {
		"frontendDist": "dist"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"app": {
		"windows": [
			{
				"theme": "Dark",
				"title": "rism",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	}
}
